# Copy to .env and fill in real values.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/ilokal_db?schema=public
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
# Comma-separated allowed frontend origins (local + Vercel).
FRONTEND_ORIGIN=http://localhost:3000,https://ilokal-merchant.vercel.app
COOKIE_NAME=ilokal_token
# Cross-site Vercel → Railway login requires SameSite=None; Secure.
# Local dev can keep lax / COOKIE_SECURE=false. Railway production should use:
# COOKIE_SAMESITE=none and COOKIE_SECURE=true (also the production defaults).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
SEED_SUPER_ADMIN_EMAIL=superadmin@ilokal.my
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin123!
SEED_SUPER_ADMIN_NAME=David R.
SEED_OPERATIONS_EMAIL=meiling@ilokal.my
SEED_OPERATIONS_PASSWORD=Operations123!
SEED_ADMIN_EMAIL=faiz@ilokal.my
SEED_ADMIN_PASSWORD=Admin123!
